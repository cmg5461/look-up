# ---- Where you are -------------------------------------------------------
# SECRET-ish: this is where you live. .env is gitignored; keep it that way.
# Decimal degrees. Negative = south / west.
# Only a 2-decimal rounding of this is ever sent to the ADS-B feed; exact
# distances and bearings are computed locally.
LAT=
LON=

# How far out to watch, in nautical miles (1 nm = 1.15 miles). Max 250.
RADIUS_NM=25

# ---- Push target ---------------------------------------------------------
# ntfy.sh needs no account: install the ntfy app, subscribe to this exact
# topic string, and you are done.
#
# SECRET. Anyone who knows this string can read every alert, including your
# approximate location. Never commit a real value here - this file is the one
# that gets checked in.
#
# `npm run init` creates .env with a fresh random topic already filled in, or
# generate one yourself:
#   node -e "console.log('lookup-'+require('crypto').randomBytes(6).toString('hex'))"
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# SECRET. Only needed for a self-hosted or access-controlled ntfy server.
NTFY_TOKEN=

# SECRET. Pushover instead of, or as well as, ntfy.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ---- What counts as an alert --------------------------------------------
ALERT_MILITARY=true
ALERT_NO_CALLSIGN=true

# "Interesting" and PIA (Privacy ICAO Address - a rotating, anonymised hex
# code) are the flags that actually catch government and surveillance types.
ALERT_INTERESTING=true
ALERT_PIA=true

# LADD is the FAA's Limiting Aircraft Data Displayed opt-out list. It is off
# by default because the flag is applied liberally and goes stale: scheduled
# airliners routinely carry it, which makes it the noisiest rule here.
ALERT_LADD=false

# ---- Noise control -------------------------------------------------------
# Seconds between checks. Please do not go below 15 - these feeds are free
# and volunteer-funded.
POLL_SECONDS=30

# Skip aircraft on the ground (parked or taxiing) rather than in the air.
IGNORE_GROUND=true

# Ignore anything above this altitude in feet. Blank = no ceiling.
# 20000 is a good starting point: it cuts airliners in cruise but keeps
# anything actually working your area.
MAX_ALT_FT=

# Ignore anything lower than this many degrees above your horizon.
# 90 = straight up, 0 = on the horizon. 30 means "roughly overhead".
# Blank = alert anywhere inside RADIUS_NM.
MIN_ELEVATION_DEG=

# The no-callsign rule is by far the noisiest, so it gets its own tighter
# limits. Blank on either = fall back to the global setting above.
NO_CALLSIGN_MAX_NM=10
NO_CALLSIGN_MAX_ALT_FT=15000
# Skip MLAT/TIS-B targets, which routinely lack a callsign for boring
# reasons (the position was derived by ground receivers, not broadcast).
NO_CALLSIGN_SKIP_MLAT_TISB=true

# ---- Overhead prediction (dead reckoning) --------------------------------
# Project each aircraft forward along its current ground track and alert when
# that track will carry it through the patch of sky you can actually see.
OVERHEAD=true

# Only alert on predicted passes. With this on, an interesting aircraft that
# stays 8nm to your north never pings you, because you would never see it.
# Turn it off to also get the plain in-radius alerts.
OVERHEAD_ONLY=true

# Which aircraft to project. "flagged" = only ones that trip a rule
# (military, PIA, no-callsign...). "all" = every aircraft, airliners included,
# which is a lot of notifications.
OVERHEAD_SCOPE=flagged

# The bubble. Three constraints, whichever binds first.
#
# 1. Your horizon, in degrees above level. This is where your treeline,
#    rooftops or terrain actually cut off the sky - a fact about where you
#    stand, not a taste setting. Roughly 5-15 in wooded suburbia, near 0 over
#    open water, more in a valley. Stand outside, look at the lowest sky you
#    can see, and estimate. It is what decides whether you catch a helicopter
#    at 400ft: at 10 degrees you see it out to 0.37nm, at 5 degrees to 0.75nm.
OVERHEAD_HORIZON_DEG=10
#
# 2. How far away horizontally still counts as "overhead". Binds for high
#    aircraft, where the horizon angle alone would sweep in half the county.
#    Lower it for a stricter definition of straight up.
OVERHEAD_MAX_GROUND_NM=3
#
# 2b. A cylinder unioned onto the cone: anything within this distance
#    horizontally counts whatever its elevation. The cone says a helicopter at
#    400ft beyond 0.37nm is behind your treeline - true of your eyes, and
#    irrelevant to your ears. This only reaches below the altitude where the
#    cone is narrower than it is: at 10 degrees and 1nm, everything under
#    about 1,070ft. Above that the cone is already wider. Set 0 to disable.
OVERHEAD_CYLINDER_NM=1
#
# 3. Slant range past which it is an unresolvable dot. Rarely the binding
#    constraint unless you raise MAX_GROUND a long way.
OVERHEAD_MAX_SLANT_NM=25

# How far ahead to project. Longer means more warning and worse accuracy,
# since dead reckoning assumes the aircraft holds its current track.
OVERHEAD_LOOKAHEAD_MIN=6

# Simulation step. Smaller is more precise about brief passes; 5s is plenty.
OVERHEAD_STEP_SECONDS=5

# Ignore anything slower than this (hovering helicopters, taxiing aircraft).
OVERHEAD_MIN_SPEED_KT=40

# ---- Straightness gate ---------------------------------------------------
# Dead reckoning assumes constant velocity in a straight line. One observation
# cannot tell you whether that holds: a jet halfway round a turn looks exactly
# like a jet holding that heading. So the recent positions are fitted and the
# fit is checked before any projection is trusted.
#
# The fit is two least-squares regressions - x against time and y against time
# - which together describe motion at constant velocity. Altitude is ignored.
# The residual is therefore not an abstract goodness-of-fit: it measures how
# wrong dead reckoning already is over the window just observed. A turn curves
# the path; a deceleration curves x(t) and y(t) even on a dead-straight path.
# One number catches both.
OVERHEAD_REQUIRE_STRAIGHT=true

# Samples arrive one per poll, so 4 samples at POLL_SECONDS=30 means about 90
# seconds of watching before a newly-seen aircraft can alert. Config
# validation rejects a warm-up longer than the lookahead window.
OVERHEAD_MIN_SAMPLES=4
OVERHEAD_MIN_SPAN_SECONDS=60

# RMS deviation from that fit, as a fraction of distance travelled. Being a
# ratio it is independent of speed - a 0.2 deg/s turn reads the same whether
# the aircraft is doing 450 knots or 110. For scale, at 4 samples 30s apart:
#   0.0026  worst-case ADS-B position jitter on a straight track
#   0.0087  a 0.1 deg/s drift, still usable
#   0.0175  a 0.2 deg/s turn
#   0.0208  dead straight but decelerating 450 -> 300 kt
#   0.0752  a standard-rate turn
OVERHEAD_MAX_PATH_RESIDUAL=0.015

# ---- Local tail database -------------------------------------------------
# Keep a local copy of the hex -> type/registration database, so aircraft the
# feeds cannot name still get identified. Worth it: the feeds return no type
# at all for some rare airframes. ~8MB download, 31MB on disk.
TAILDB=true
TAILDB_MAX_AGE_DAYS=14

# ---- Repeat suppression --------------------------------------------------
# Re-alert about the same aircraft only after it has been gone this long.
REVISIT_MINUTES=30
# Minimum gap before the same aircraft can alert again for a new reason.
RE_ALERT_MINUTES=10

# ---- Notification priority -----------------------------------------------
# How intrusive each alert is, on ntfy's 1-5 scale:
#   5 max     really long, repeating vibration burst; bypasses Do Not Disturb
#   4 high    long vibration burst, pop-over notification
#   3 default a normal notification - short vibration and sound
#   2 low     silent, no vibration; still appears in the drawer
#   1 min     silent and collapsed until you pull the drawer down
# All default to 3 (a normal notification). Raise MILITARY to 4 or 5 only if
# you want a C-17 overhead to interrupt whatever you are doing; 5 is the one
# that vibrates through Do Not Disturb.
PRIORITY_MILITARY=3
PRIORITY_SPECIAL=3
PRIORITY_NO_CALLSIGN=3
